<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Security">
        <ListPreference
            app:defaultValue="30"
            app:entries="@array/lock_entries"
            app:entryValues="@array/lock_values"
            app:key="auto_lock"
            app:title="Auto-lock"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:key="biometric_unlock"
            app:persistent="false"
            app:summary="Use fingerprint, face or phone lock instead of typing the passphrase"
            app:title="Unlock with biometrics" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="secure_screen"
            app:summary="Blocks screenshots and hides the app in recent apps"
            app:title="Block screenshots" />

        <Preference
            app:key="change_passphrase"
            app:summary="Your notes are not re-encrypted, only the key wrapper changes"
            app:title="Change passphrase" />

        <Preference
            app:key="lock_now"
            app:title="Lock now" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Cloud sync">
        <Preference
            app:key="sync_account"
            app:summary="Off. Tap to turn on"
            app:title="Google Drive sync" />

        <Preference
            app:key="sync_now"
            app:title="Sync now" />

        <Preference
            app:key="sync_storage"
            app:summary="Tap to check"
            app:title="Cloud storage used" />

        <Preference
            app:key="sync_off"
            app:title="Sign out of Google"
            app:summary="Switch account or erase data" />

        <Preference
            app:key="sync_delete"
            app:summary="Removes every encrypted file this app stored in your Drive"
            app:title="Delete all cloud data" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Appearance">
        <ListPreference
            app:defaultValue="system"
            app:entries="@array/theme_entries"
            app:entryValues="@array/theme_values"
            app:key="theme"
            app:title="Theme"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="dynamic_color"
            app:summary="Use wallpaper colors on Android 12+. Restart the app to apply."
            app:title="Dynamic colors" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Reminders">
        <Preference
            app:key="notif_settings"
            app:summary="Allow or change reminder notifications"
            app:title="Notification settings" />
    </PreferenceCategory>

    <PreferenceCategory app:title="About">
        <Preference
            app:selectable="false"
            app:summary="Version 1.0 · notes are encrypted on this device"
            app:title="VaultNote" />
    </PreferenceCategory>
</PreferenceScreen>